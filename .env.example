# ── Telegram (обязательно) ────────────────────────────────
BOT_TOKEN=123456789:AA...your_telegram_bot_token

# ── Steam (ключ не обязателен: store-эндпоинты публичны) ───
STEAM_API_KEY=
STEAM_CC=us
STEAM_PRICE_REGIONS=USD:us,EUR:de,RUB:ru

# ── ИИ-выжимка отзывов (любой OpenAI-совместимый провайдер) ─
# Бесплатно: Groq (https://console.groq.com/keys) или Gemini
# (https://aistudio.google.com/apikey) или локальный Ollama.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
OPENAI_MODEL=llama-3.3-70b-versatile

# ── OpenCritic (опционально, RapidAPI) ────────────────────
OPENCRITIC_RAPIDAPI_KEY=

# ── IGDB через Twitch (жанры, похожие, /top, /random) ─────
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── IsThereAnyDeal (история цен, минимум за всё время) ────
# https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# ── Перевод отзывов (опционально) ─────────────────────────
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
DEEPL_API_KEY=

# ── Прочее ────────────────────────────────────────────────
DEFAULT_LANG=ru
LOG_LEVEL=info
CACHE_TTL_MS=3600000
