# Скопируй этот файл в .env и впиши свои ключи

# Токен от @BotFather
BOT_TOKEN=123456789:AA...your_telegram_bot_token

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key
STEAM_CC=us

# ИИ для выжимки отзывов — любой OpenAI-совместимый провайдер.
# Бесплатно: Groq (https://console.groq.com/keys) или Gemini
# (https://aistudio.google.com/apikey) или локальный Ollama.
# Платно: OpenAI (https://platform.openai.com/api-keys) — BASE_URL пустой.
#
# Пример для Groq (бесплатно):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenCritic (опционально): https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api
OPENCRITIC_RAPIDAPI_KEY=
